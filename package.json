{
  "name": "turboism-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/**/*.test.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "release:check": "npm test && npm run lint && npm run typecheck",
    "release:build": "npm run release:check && vercel build",
    "verify:deployment": "vercel inspect --wait --timeout=5m",
    "verify:production": "npm run verify:deployment -- https://docs.turboism.dev",
    "generate:sdk-api": "node scripts/sync-sdk-api.mjs",
    "generate:sdk-api:git": "node scripts/generate-sdk-api-from-git.mjs",
    "sync:sdk-api": "node scripts/sync-sdk-api.mjs --sync",
    "sync:sdk-api:git": "node scripts/generate-sdk-api-from-git.mjs --sync"
  },
  "dependencies": {
    "fumadocs-core": "^16.14.0",
    "fumadocs-mdx": "^15.2.1",
    "fumadocs-ui": "^16.14.0",
    "lucide-react": "^1.23.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/mdx": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.0"
  }
}
